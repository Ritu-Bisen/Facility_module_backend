<?xml version="1.0" encoding="utf-8"?>
<!-- 
  ===================================================================
  IIS 10.0 CONFIGURATION FOR NODE.JS BACKEND (iisnode)
  Path: /FacNodeAPI/
  ===================================================================
  Prerequisites on IIS 10.0:
  1. iisnode v0.2.21+ (x64) installed
  2. IIS URL Rewrite Module 2.0+ installed
  ===================================================================
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- Remove existing handler if present to avoid IIS duplicate handler errors -->
      <remove name="iisnode" />
      <!-- Indicates that src/server.js is a Node.js application to be handled by iisnode -->
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>
    
    <rewrite>
      <rules>
        <!-- Do not interfere with requests for logs -->
        <rule name="LogFile" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="iisnode" />
        </rule>
        
        <!-- Do not interfere with requests for node-inspector debugging -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^src/server.js\/debug[\/]?" />
        </rule>

        <!-- All other URLs are mapped to the Node.js application entry point -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="src/server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <!-- removeServerHeader="true" mitigates Server header disclosure on IIS 10+ -->
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    
    <httpProtocol>
      <customHeaders>
        <!-- Remove all technology version disclosure headers (CWE-200 / Vulnerability Point 14) -->
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <remove name="X-ARR-Version" />
        <remove name="Server" />

        <!-- HSTS Enforce 1-Year Max Age with includeSubDomains & preload (CWE-693 / Vulnerability Point 17) -->
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        
        <!-- MIME Sniffing Protection -->
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    
    <!-- CWE-209: Prevent detailed IIS error pages -->
    <httpErrors errorMode="Custom" existingResponse="Replace" />
    
    <!-- iisnode settings: Ensure devErrors are disabled for production (CWE-209 / Vulnerability Point 18) -->
    <iisnode loggingEnabled="true" devErrorsEnabled="false" />
  </system.webServer>

  <system.web>
    <!-- Prevent ASP.NET stack trace yellow exception screens (CWE-209 / Vulnerability Point 18) -->
    <customErrors mode="On" />
    <!-- Mitigate CWE-200 X-AspNet-Version Disclosure -->
    <httpRuntime enableVersionHeader="false" />
  </system.web>
</configuration>
