<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <system.webServer>

    <handlers>
      <!-- Remove IIS built-in OPTIONS handler so Express CORS can handle preflight requests -->
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <!-- Indicates that the src/server.js file is a Node.js application to be handled by the iisnode module -->
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>

      <outboundRules>
        <rule name="Remove ARR Header">
          <match serverVariable="RESPONSE_X-Powered-By" pattern=".*" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>

      <rules>
        <!-- Block HTTP TRACE, TRACK, DEBUG methods (CWE-200) -->
        <rule name="Block Disallowed Verbs" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_METHOD}" pattern="^(TRACE|TRACK|DEBUG)$" />
          </conditions>
          <action type="CustomResponse" statusCode="405" statusReason="Method Not Allowed" statusDescription="HTTP method is disallowed." />
        </rule>

        <rule name="ReverseProxyInboundRule1" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3001/{R:1}" />
        </rule>

        <!-- Do not interfere with requests for logs -->
        <rule name="LogFile" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="iisnode" />
        </rule>

        <!-- Do not interfere with requests for node-inspector debugging -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^src/server.js\/debug[\/]?" />
        </rule>

      </rules>
    </rewrite>

    <security>
      <!-- removeServerHeader="true" mitigates Server header disclosure (IIS 10+) & block dangerous HTTP methods (CWE-200) -->
      <!-- CRITICAL FIX: DO NOT block OPTIONS verb here, otherwise CORS preflight requests from React frontend will be rejected by IIS with 404/403! -->
      <requestFiltering removeServerHeader="true">
        <verbs allowUnlisted="true">
          <add verb="TRACE" allowed="false" />
          <add verb="TRACK" allowed="false" />
          <add verb="DEBUG" allowed="false" />
        </verbs>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- Remove technology and method disclosure headers (CWE-200) -->
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <remove name="X-ARR-Version" />
        <remove name="Server" />
        <remove name="Allow" />
        <remove name="Public" />

        <!-- HSTS Enforce Max Age (CWE-693) -->
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />

        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- CWE-209: Prevent detailed IIS error pages -->
    <httpErrors errorMode="Custom" existingResponse="Replace" />

  </system.webServer>

  <system.web>
    <!-- Mitigate CWE-200 X-AspNet-Version Disclosure -->
    <httpRuntime enableVersionHeader="false" />
  </system.web>

</configuration>