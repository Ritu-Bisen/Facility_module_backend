  "item": [
    {
      "name": "Auth - Password Login",
      "description": "Login endpoints using Password. Tokens are auto-saved to collection variables on success.",
      "item": [
        {
          "name": "Login with Email (Success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/email",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                "email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"chctilda@dpdmis.in\",\n  \"password\": \"Common@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has tokens', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.accessToken).to.be.a('string');",
                  "  pm.expect(json.refreshToken).to.be.a('string');",
                  "  if (json.accessToken) { pm.collectionVariables.set('accessToken', json.accessToken); }",
                  "  if (json.refreshToken) { pm.collectionVariables.set('refreshToken', json.refreshToken); }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with Phone (Success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
